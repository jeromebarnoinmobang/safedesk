# === Identité conteneur ===
PUID=1000
PGID=1000
TZ=Europe/Paris

# === Accès au bureau ===
DESKTOP_USER=jerome
DESKTOP_PASSWORD=change-moi

# === VPS / Traefik (déploiement streamé uniquement) ===
DESKTOP_DOMAIN=desktop.mobang.fr
# Basic auth Traefik. Génère avec :  htpasswd -nb jerome 'motdepasse'
# Dans un fichier .env, DOUBLE chaque $ -> $$   (ex: $$apr1$$....)
DESKTOP_BASICAUTH=jerome:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxxx
