# === Identite du conteneur ===
PUID=1000
PGID=1000
TZ=Europe/Paris

# === Acces au bureau (auth du serveur de bureau, servie sous HTTPS) ===
DESKTOP_USER=user
DESKTOP_PASSWORD=change-me

# === Deploiement distant / Traefik uniquement ===
# Le sous-domaine doit pointer (DNS A) vers l IP du serveur ou tourne Traefik.
DESKTOP_DOMAIN=desktop.example.com

# === Optionnel ===
# Fige le nom de projet Compose (donc les noms de volumes) si vous renommez le dossier.
# COMPOSE_PROJECT_NAME=safedesk
# Reverse proxy (deploiement distant)
# PROXY_NETWORK=proxy
# CERT_RESOLVER=letsencrypt

# Composants proprietaires optionnels (desactives par defaut)
# INSTALL_CHROME=true   # Google Chrome : seul a permettre la synchronisation d un compte Google
# INSTALL_CLAUDE=true   # Claude Desktop (beta Linux)

# Acces telephone (Moonlight) — optionnel
# INSTALL_SUNSHINE=true
# SUNSHINE_BIND_IP=100.64.0.1   # IP PRIVEE (VPN/tailnet) uniquement, jamais 0.0.0.0

# Forge APK dans le bureau (optionnel)
# INSTALL_FORGE=true
# SAFEDESK_FORGE_REMOTE=https://github.com/<vous>/safedesk.git

# Icone QR telephone
# SAFEDESK_NAME=SafeDesk de Camille
# SAFEDESK_URL=https://desktop.example.com
# SAFEDESK_APP_URL=https://github.com/<vous>/safedesk/releases/download/app-vX/SafeDesk-X.apk
