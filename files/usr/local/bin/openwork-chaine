#!/bin/bash
# openwork-chaine — monte et GARDE la chaîne OpenWork du poste SafeDesk.
#
# ═══════════════════════════════════════════════════════════════════════════════
# POURQUOI CE SCRIPT EXISTE (26/08/2026)
#
# Jérôme : « j'ai beau lancer l'interface rien n'apparaît ». La chaîne était
# entière SAUF un maillon : l'adresse que le front appelait. Le front rendait 200,
# et tapait sur `https://openwork-api.mobang.fr` qui rendait 502. Le navigateur
# affichait donc une page vide.
#
# Et surtout : PERSONNE NE L'A VU PENDANT PLUS DE 24 H, parce que le lanceur
# testait `curl http://127.0.0.1:14880` — et un front périmé pointé sur une API
# morte rend 200. Le contrôle de santé mentait.
#
# LA RÈGLE QUI EN DÉCOULE, ET C'EST TOUT LE SCRIPT :
#   on ne demande pas au front s'il va bien, on REGARDE OÙ IL TAPE.
#   L'adresse est lue dans l'environnement du processus vivant (/proc/<pid>/environ),
#   pas dans un fichier qu'on a écrit — un fichier dérive, un /proc ne ment pas.
# ═══════════════════════════════════════════════════════════════════════════════
#
# Usage :
#   openwork-chaine etat        état des maillons ; code retour 0 si tout tient
#   openwork-chaine assurer     répare ce qui manque (idempotent) — c'est le service
#   openwork-chaine relancer    tue tout et remonte
#   openwork-chaine stop        arrête tout (opencode continue sur le VPS)
#
# Variables :
#   OPENWORK_TEL=0   désactive le volet téléphone (front 14881 + tunnel inverse)
set -u

# PATH — SANS CETTE LIGNE, RIEN NE DÉMARRE DEPUIS L'ICÔNE NI DEPUIS s6.
# `Terminal=false` dans le .desktop et un service s6 démarrent tous deux SANS shell
# de connexion, donc sans /config/.local/bin — et c'est là que vit `bun`.
# Symptôme mesuré le 25/08/2026 : fork.log ne contenait qu'une ligne,
# « nohup: failed to run command 'bun': No such file or directory », datée du 24/08
# à 09:13. La chaîne était morte depuis, sans que rien ne le dise.
export HOME=${HOME:-/config}
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

APP=/config/Projects/openwork-app
RUN=$APP/tmp
LOG=$RUN/logs

PORT_OC=14098          # tunnel SORTANT vers opencode du VPS (127.0.0.1:4096 là-bas)
PORT_SRV=14877         # serveur openwork (local)
PORT_FRONT=14880       # front du BUREAU        -> API locale
PORT_FRONT_TEL=14881   # front du TÉLÉPHONE     -> API publique
PORT_VOICE=8089        # page vocale (déjà servie par un autre service)
VPS=mobang-prod
TUNNEL_OC="$PORT_OC:127.0.0.1:4096"

# Le port local est 14098, PAS 14099 : si un ancien fork tournait encore sur 14099,
# réutiliser ce numéro ferait passer une panne de tunnel pour un succès.

API_LOCALE="http://127.0.0.1:$PORT_SRV"
API_PUBLIQUE=https://openwork-api.mobang.fr

ENV_OC=/config/.config/safedesk/opencode-vps.env   # OPENCODE_SERVER_USERNAME/PASSWORD
ENV_OW=/config/.config/safedesk/openwork.env       # OPENWORK_TOKEN

ETAT_LOG=/config/.local/state/safedesk/openwork.log

# ─────────────────────────────────────────────────────────────────────────────
# Outils
# ─────────────────────────────────────────────────────────────────────────────

trace() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$ETAT_LOG"; }
dire()  { printf '%s\n' "$*"; trace "$*"; }

# pid_du_port — QUI écoute ce port, par le noyau. C'est la seule méthode sûre :
# `pkill -f <motif>` sur un motif qui figure dans sa PROPRE ligne de commande se
# tue lui-même (mesuré deux fois, exit 144).
pid_du_port() {
  ss -lntpH "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

# tuer_le_port — libère un port et ATTEND qu'il le soit vraiment. Sans cette
# attente, la relance repart trop tôt et meurt sur « address already in use » —
# exactement ce qui a fait échouer le correctif du 25/08 à 19:01.
tuer_le_port() {
  local port=$1 pid
  pid=$(pid_du_port "$port") || true
  [ -n "${pid:-}" ] || return 0
  [ "$pid" = "$$" ] && return 0
  kill "$pid" 2>/dev/null
  for _ in $(seq 1 20); do
    sleep 0.25
    [ -z "$(pid_du_port "$port")" ] && return 0
  done
  kill -9 "$pid" 2>/dev/null
  sleep 0.5
}

# env_du_pid — la VÉRITÉ sur ce avec quoi un processus a été lancé.
env_du_pid() {
  tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -1
}

http_ok() { curl -sf -m "${3:-6}" -o /dev/null "$1" ${2:+-u "$2"} 2>/dev/null; }

charger_env() {
  [ -r "$ENV_OC" ] || { dire "MANQUE : $ENV_OC (identifiants opencode du VPS)"; return 1; }
  [ -r "$ENV_OW" ] || { dire "MANQUE : $ENV_OW (OPENWORK_TOKEN)"; return 1; }
  # shellcheck disable=SC1090
  . "$ENV_OC"; . "$ENV_OW"
  : "${OPENCODE_SERVER_USERNAME:?}" "${OPENCODE_SERVER_PASSWORD:?}" "${OPENWORK_TOKEN:?}"
}

# ─────────────────────────────────────────────────────────────────────────────
# Les CONSTATS — ils calculent un verdict, ils n'écrivent rien et ne réparent rien.
# (Séparer constater de réparer est ce qui rend `etat` utilisable comme preuve.)
# ─────────────────────────────────────────────────────────────────────────────

constater_tunnel_oc() {
  http_ok "http://127.0.0.1:$PORT_OC/global/health" \
          "$OPENCODE_SERVER_USERNAME:$OPENCODE_SERVER_PASSWORD" 6
}

constater_serveur() { http_ok "$API_LOCALE/health" "" 6; }

# constater_front — LE CŒUR DU CORRECTIF.
# Trois conditions, et la troisième est celle qui manquait :
#   1. quelqu'un écoute le port
#   2. il rend 200
#   3. L'API QU'IL APPELLE RÉELLEMENT répond
# Sans (3), un front pointé sur une adresse morte passe pour sain.
constater_front() {
  local port=$1 api_attendue=$2 pid api
  pid=$(pid_du_port "$port"); [ -n "${pid:-}" ] || return 1
  http_ok "http://127.0.0.1:$port" "" 6 || return 1
  api=$(env_du_pid "$pid" VITE_OPENWORK_URL)
  [ -n "$api" ] || return 1
  [ "$api" = "$api_attendue" ] || return 1
  http_ok "$api/health" "" 8
}

constater_tunnel_inverse() { pgrep -f "0.0.0.0:14980:127.0.0.1:$PORT_FRONT_TEL" >/dev/null 2>&1; }

telephone_actif() { [ "${OPENWORK_TEL:-1}" = "1" ]; }

# ─────────────────────────────────────────────────────────────────────────────
# Les POSES — elles réparent. Chacune est idempotente.
# ─────────────────────────────────────────────────────────────────────────────

poser_tunnel_oc() {
  for p in $(pgrep -f "$TUNNEL_OC" 2>/dev/null); do [ "$p" != "$$" ] && kill "$p" 2>/dev/null; done
  tuer_le_port "$PORT_OC"
  # ExitOnForwardFailure : sans lui, ssh réussit même si le port local est pris, et
  # on croit parler au VPS alors qu'on parle à un vieux processus.
  ssh -N -f -o BatchMode=yes -o ExitOnForwardFailure=yes \
      -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
      -L "127.0.0.1:$TUNNEL_OC" "$VPS" >>"$LOG/tunnel.log" 2>&1 || {
    dire "ÉCHEC tunnel opencode vers $VPS — vérifie : ssh $VPS 'docker ps --filter name=opencode-vps'"
    return 1
  }
  for _ in $(seq 1 40); do constater_tunnel_oc && return 0; sleep 0.5; done
  dire "ÉCHEC : opencode du VPS muet sur :$PORT_OC après 20 s"
  return 1
}

poser_serveur() {
  tuer_le_port "$PORT_SRV"
  mkdir -p "$RUN/t3-workspace" "$LOG"
  [ -f "$RUN/t3-server.json" ] || echo '{}' > "$RUN/t3-server.json"
  # `exec` N EST PAS COSMÉTIQUE : sans lui, le sous-shell reste vivant comme parent
  # du serveur, et `pgrep -f openwork-chaine` compte des coquilles vides. Un
  # inventaire de processus qui ment est la première marche vers un diagnostic faux.
  # Avec `exec`, le sous-shell DEVIENT le processus : un lancé, un vu.
  # `</dev/null` : un démon qui garde stdin ouvert vole l entrée de son lanceur.
  #
  # Les identifiants opencode sont obligatoires : le serveur du VPS refuse tout en 401.
  ( cd "$APP/apps/server" && exec nohup env OPENWORK_DEV_MODE=1 \
      OPENWORK_OPENCODE_BASE_URL="http://127.0.0.1:$PORT_OC" \
      OPENWORK_OPENCODE_USERNAME="$OPENCODE_SERVER_USERNAME" \
      OPENWORK_OPENCODE_PASSWORD="$OPENCODE_SERVER_PASSWORD" \
      bun --conditions=development src/cli.ts \
        --config "$RUN/t3-server.json" \
        --port "$PORT_SRV" --token "$OPENWORK_TOKEN" --host-token "$OPENWORK_TOKEN" \
        --workspace "$RUN/t3-workspace" \
        --cors "http://127.0.0.1:$PORT_FRONT,http://localhost:$PORT_FRONT,http://127.0.0.1:$PORT_FRONT_TEL,https://openwork.mobang.fr" \
        --verbose >"$LOG/server.log" 2>&1 </dev/null ) &
  for _ in $(seq 1 60); do constater_serveur && return 0; sleep 0.5; done
  dire "ÉCHEC : serveur openwork muet sur :$PORT_SRV après 30 s (voir $LOG/server.log)"
  return 1
}

# poser_front — un vite, une API, un port. Le BUREAU et le TÉLÉPHONE en ont chacun
# un : `http://127.0.0.1:14877` ne veut rien dire depuis un téléphone, et une seule
# adresse d'API ne peut pas servir les deux mondes.
poser_front() {
  local port=$1 api=$2 vport=$3 fichier_log=$4
  tuer_le_port "$port"
  mkdir -p "$LOG"
  # `exec` : même raison que pour le serveur — le sous-shell devient vite au lieu de
  # survivre à côté. C est aussi ce qui rend `/proc/<pid>/environ` fiable : le PID
  # qui écoute le port EST celui qui porte VITE_OPENWORK_URL, sans indirection.
  ( cd "$APP/apps/app" && exec nohup env OPENWORK_DEV_MODE=1 \
      VITE_OPENWORK_URL="$api" VITE_OPENWORK_PORT="$vport" \
      VITE_OPENWORK_TOKEN="$OPENWORK_TOKEN" VITE_OPENWORK_FORCE_ENV_SETTINGS=1 \
      VITE_OPENWORK_DEPLOYMENT=web VITE_DISABLE_OPENWORK_MODELS=1 \
      VITE_ALLOWED_HOSTS=openwork.mobang.fr \
      ./node_modules/.bin/vite --host 127.0.0.1 --port "$port" --strictPort \
        >"$LOG/$fichier_log" 2>&1 </dev/null ) &
  for _ in $(seq 1 60); do
    constater_front "$port" "$api" && return 0
    sleep 0.5
  done
  dire "ÉCHEC : front :$port ne répond pas ou ne joint pas $api (voir $LOG/$fichier_log)"
  return 1
}

poser_tunnel_inverse() {
  for p in $(pgrep -f "0.0.0.0:14980:127.0.0.1:" 2>/dev/null); do kill "$p" 2>/dev/null; done
  # Tunnel SORTANT : rien n'est ouvert sur la box. Traefik du VPS joint ces ports par
  # la passerelle docker (172.18.0.1) — routes dans /opt/mobang/traefik/dynamic/openwork.yml.
  # 14980 remonte le front TÉLÉPHONE (14881), pas celui du bureau.
  local args=(-R "0.0.0.0:14980:127.0.0.1:$PORT_FRONT_TEL"
              -R "0.0.0.0:14977:127.0.0.1:$PORT_SRV")
  # ON NE TUNNELISE PAS UN PORT MORT. La page vocale (:8089) n'est démarrée que par
  # `voice/start-voice-discussion.sh`, à la main, et rien ne la relève. Publier
  # 14989 vers un port éteint fait rendre 502 à voice.mobang.fr — c'est-à-dire
  # transformer « ce service n'est pas lancé » en « le réseau est cassé ».
  # Le tunnel ne porte donc ce renvoi QUE si quelque chose écoute vraiment.
  if [ -n "$(pid_du_port "$PORT_VOICE")" ]; then
    args+=(-R "0.0.0.0:14989:127.0.0.1:$PORT_VOICE")
  else
    trace "voix :$PORT_VOICE éteinte — renvoi 14989 non publié (voir voice/start-voice-discussion.sh)"
  fi
  ssh -N -f -o BatchMode=yes -o ExitOnForwardFailure=yes \
      -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
      "${args[@]}" "$VPS" >>"$LOG/tunnel-inverse.log" 2>&1 || {
    dire "téléphone : tunnel inverse refusé (le bureau n'en dépend pas)"
    return 1
  }
  sleep 1
  constater_tunnel_inverse
}

# ─────────────────────────────────────────────────────────────────────────────
# Commandes
# ─────────────────────────────────────────────────────────────────────────────

cmd_etat() {
  charger_env || return 2
  local rc=0 pid api
  if constater_tunnel_oc; then
    printf 'tunnel-opencode :%-6s OK   %s\n' "$PORT_OC" \
      "$(curl -sf -m 6 -u "$OPENCODE_SERVER_USERNAME:$OPENCODE_SERVER_PASSWORD" \
           "http://127.0.0.1:$PORT_OC/global/health" 2>/dev/null)"
  else
    printf 'tunnel-opencode :%-6s MORT\n' "$PORT_OC"; rc=1
  fi

  if constater_serveur; then
    printf 'serveur-openwork:%-6s OK   %s\n' "$PORT_SRV" \
      "$(curl -sf -m 6 "$API_LOCALE/health" 2>/dev/null)"
  else
    printf 'serveur-openwork:%-6s MORT\n' "$PORT_SRV"; rc=1
  fi

  # On IMPRIME l'API réellement appelée. C'est la ligne qui, le 26/08, aurait
  # montré la panne en une seconde au lieu de vingt-quatre heures.
  pid=$(pid_du_port "$PORT_FRONT")
  api=$([ -n "${pid:-}" ] && env_du_pid "$pid" VITE_OPENWORK_URL)
  if constater_front "$PORT_FRONT" "$API_LOCALE"; then
    printf 'front-bureau    :%-6s OK   appelle %s\n' "$PORT_FRONT" "$api"
  else
    printf 'front-bureau    :%-6s MORT appelle %s (attendu %s)\n' \
      "$PORT_FRONT" "${api:-<rien>}" "$API_LOCALE"; rc=1
  fi

  if telephone_actif; then
    pid=$(pid_du_port "$PORT_FRONT_TEL")
    api=$([ -n "${pid:-}" ] && env_du_pid "$pid" VITE_OPENWORK_URL)
    if constater_front "$PORT_FRONT_TEL" "$API_PUBLIQUE"; then
      printf 'front-telephone :%-6s OK   appelle %s\n' "$PORT_FRONT_TEL" "$api"
    else
      printf 'front-telephone :%-6s absent (le bureau n en depend pas)\n' "$PORT_FRONT_TEL"
    fi
    constater_tunnel_inverse \
      && printf 'tunnel-inverse  :        OK   14980->%s 14977->%s\n' "$PORT_FRONT_TEL" "$PORT_SRV" \
      || printf 'tunnel-inverse  :        absent (le bureau n en depend pas)\n'
  fi
  return $rc
}

# cmd_assurer — la boucle de réparation. Ordre STRICT : les maillons du bureau
# d'abord, ceux du téléphone ensuite. Un échec côté téléphone ne bloque jamais le
# bureau, et c'est délibéré : SafeDesk doit rester utilisable seul.
cmd_assurer() {
  charger_env || return 2
  mkdir -p "$LOG" "$(dirname "$ETAT_LOG")"

  constater_tunnel_oc || { trace "réparation : tunnel opencode"; poser_tunnel_oc || return 1; }
  constater_serveur   || { trace "réparation : serveur openwork"; poser_serveur   || return 1; }
  constater_front "$PORT_FRONT" "$API_LOCALE" \
    || { trace "réparation : front bureau"; poser_front "$PORT_FRONT" "$API_LOCALE" "$PORT_SRV" front.log || return 1; }

  if telephone_actif; then
    # Le front téléphone n'a de sens que si l'API publique est joignable ; sinon on
    # ne le monte pas — un front qui pointe sur du vide est précisément le défaut
    # qu'on répare ici, et le monter « au cas où » le recréerait.
    if http_ok "$API_PUBLIQUE/health" "" 8; then
      constater_front "$PORT_FRONT_TEL" "$API_PUBLIQUE" \
        || poser_front "$PORT_FRONT_TEL" "$API_PUBLIQUE" 443 front-telephone.log || true
    fi
    constater_tunnel_inverse || poser_tunnel_inverse || true
  fi
  return 0
}

cmd_stop() {
  for p in $(pgrep -f "$TUNNEL_OC" 2>/dev/null); do [ "$p" != "$$" ] && kill "$p" 2>/dev/null; done
  for p in $(pgrep -f "0.0.0.0:14980:127.0.0.1:" 2>/dev/null); do kill "$p" 2>/dev/null; done
  tuer_le_port "$PORT_SRV"
  tuer_le_port "$PORT_FRONT"
  tuer_le_port "$PORT_FRONT_TEL"
  dire "chaîne arrêtée (opencode continue de tourner sur le VPS)"
}

case "${1:-etat}" in
  etat)     cmd_etat ;;
  assurer)  cmd_assurer && cmd_etat ;;
  relancer) cmd_stop; charger_env && cmd_assurer && cmd_etat ;;
  stop)     cmd_stop ;;
  *) echo "usage: openwork-chaine {etat|assurer|relancer|stop}" >&2; exit 64 ;;
esac
