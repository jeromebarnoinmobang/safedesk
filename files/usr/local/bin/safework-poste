#!/bin/bash
# safework-poste — l'ICÔNE du bureau. Elle n'a qu'un travail : ouvrir la fenêtre.
#
# CE QU'ELLE NE FAIT PLUS, ET POURQUOI (26/08/2026)
#
# Avant, cette icône DÉMARRAIT la chaîne. Deux conséquences, toutes deux mesurées :
#
#   1. Rien ne repartait au redémarrage de SafeDesk tant que Jérôme n'avait pas
#      cliqué. Une machine dont l'état dépend d'un clic n'a pas d'état.
#
#   2. Elle décidait de démarrer sur `curl -sf http://127.0.0.1:14880`. Or un front
#      PÉRIMÉ, pointé sur une API morte, rend 200. Le 25-26/08, elle a donc jugé
#      « tout va bien » pendant plus de 24 h devant une fenêtre vide.
#
# Désormais la chaîne est un service supervisé (`safedesk-safework`, s6) qui la
# monte au démarrage et la répare toutes les 30 s. L'icône se contente d'attendre
# qu'elle soit prête — et de le DIRE si elle ne l'est pas, au lieu d'ouvrir une
# fenêtre blanche.
set -u

export HOME=${HOME:-/config}
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

CHAINE=/usr/local/bin/safework-chaine
[ -x "$CHAINE" ] || CHAINE=/config/.local/bin/safework-chaine
FRONT=http://127.0.0.1:14880

# Le service a normalement déjà tout monté. S'il ne tourne pas (conteneur ancien,
# service désactivé), on répare quand même : l'icône doit marcher dans tous les cas.
if ! "$CHAINE" etat >/dev/null 2>&1; then
  ( "$CHAINE" assurer >/dev/null 2>&1 & )
  for _ in $(seq 1 90); do
    "$CHAINE" etat >/dev/null 2>&1 && break
    sleep 1
  done
fi

# ÉCHEC VISIBLE. Une fenêtre blanche ne dit rien ; un message dit quoi regarder.
if ! "$CHAINE" etat >/dev/null 2>&1; then
  DETAIL=$("$CHAINE" etat 2>&1)
  MSG="OpenWork n'a pas pu démarrer.

$DETAIL

Journal : /config/.local/state/safedesk/openwork.log
Détail  : /config/Projects/safework/tmp/logs/"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "OpenWork" --error "$MSG"
  elif command -v zenity >/dev/null 2>&1; then
    zenity --error --title="OpenWork" --text="$MSG"
  else
    printf '%s\n' "$MSG" >&2
  fi
  exit 1
fi

# wrapped-google-chrome = le wrapper SafeDesk (drapeaux conteneur) — présent sur
# les deux bureaux (:10 physique, :1 téléphone). Repli chrome nu hors SafeDesk.
CHROME=$(command -v wrapped-google-chrome || command -v google-chrome)
exec "$CHROME" --app="$FRONT" --start-fullscreen --no-first-run --password-store=basic
