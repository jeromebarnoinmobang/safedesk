#!/usr/bin/env bash
# UN SEUL QR : https://<domaine>/sd#<config>
#   - avant installation : la camera ouvre la page /sd (bouton Installer)
#   - apres : Android (App Links) ouvre directement l app, deja configuree
# La config voyage dans le #fragment : elle ne quitte JAMAIS le telephone.
# Publication auto (si /landing est monte) : forge l APK avec la cle stable du home
# et depose APK + assetlinks.json pour le domaine.
set -euo pipefail
export DISPLAY="${DISPLAY:-:1}"

err() { command -v kdialog >/dev/null && kdialog --error "$1" || echo "$1" >&2; exit 1; }
command -v qrencode >/dev/null || err "qrencode absent de cette image"

NAME="${SAFEDESK_NAME:-SafeDesk}"
URL="${SAFEDESK_URL:-}"
[ -z "$URL" ] && [ -n "${DESKTOP_DOMAIN:-}" ] && URL="https://$DESKTOP_DOMAIN"
[ -n "$URL" ] && [ -n "${CUSTOM_USER:-}" ] && [ -n "${PASSWORD:-}" ] \
  || err "Il manque SAFEDESK_URL (ou DESKTOP_DOMAIN) / CUSTOM_USER / PASSWORD"
URL="${URL%/}"

OUT="$HOME/.cache/safedesk-qr"; mkdir -p "$OUT"; chmod 700 "$OUT"

JSON=$(printf '{"v":1,"name":"%s","url":"%s","user":"%s","pass":"%s"}' "$NAME" "$URL" "$CUSTOM_USER" "$PASSWORD")
DATA=$(printf %s "$JSON" | base64 -w0 | tr "+/" "-_" | tr -d "=")
LINK="$URL/sd#$DATA"
qrencode -s 10 -m 2 -o "$OUT/one.png" "$LINK"

# Publication (arriere-plan, best-effort) : APK forge + assetlinks pour l App Link
if [ -d /landing ] && [ -w /landing ]; then
  (
    set +e
    safedesk-forge -n SafeDesk.apk -o /tmp/sd-pub >/tmp/sd-pub.log 2>&1 || exit 0
    mkdir -p /landing/sd /landing/.well-known
    cp /tmp/sd-pub/SafeDesk.apk /landing/sd/SafeDesk.apk
    KEYDIR="$HOME/.config/safedesk/keys"
    if [ -f "$KEYDIR/forge.jks" ]; then
      FP=$(keytool -list -v -keystore "$KEYDIR/forge.jks" -alias safedesk \
             -storepass "$(cat "$KEYDIR/.pass")" 2>/dev/null \
           | sed -n "s/.*SHA256: //p" | head -1)
      [ -n "$FP" ] && printf '[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"org.safedesk.app","sha256_cert_fingerprints":["%s"]}}]' "$FP" \
        > /landing/.well-known/assetlinks.json
    fi
  ) &
fi

cat > "$OUT/index.html" <<HTML
<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>$NAME — telephone</title>
<style>
body{background:#0f1115;color:#e8ecf3;font-family:sans-serif;display:flex;flex-direction:column;
     align-items:center;justify-content:center;min-height:96vh;margin:0;padding:20px;text-align:center}
h1{font-size:26px;margin:0 0 4px} .sub{color:#8b94a7;margin-bottom:22px}
img{background:#fff;padding:16px;border-radius:16px;width:min(46vh,420px)}
ol{color:#8b94a7;font-size:14px;line-height:1.7;text-align:left;max-width:430px}
b{color:#e8ecf3}
.warn{margin-top:10px;color:#eab308;font-size:12.5px;max-width:520px}
</style></head><body>
<h1>$NAME</h1><div class="sub">Un seul code, pour tout</div>
<img src="one.png" alt="QR SafeDesk">
<ol>
<li>Scanner avec l <b>appareil photo</b> → <b>Installer</b> l application.</li>
<li><b>Re-scanner le meme code</b> → l espace s ouvre, deja configure.</li>
</ol>
<div class="warn">Ce code contient les identifiants de CET espace : ne le montrer qu a la personne concernee.</div>
</body></html>
HTML

exec xdg-open "$OUT/index.html"