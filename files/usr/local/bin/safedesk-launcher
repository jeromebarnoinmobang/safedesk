#!/usr/bin/env python3
"""Lanceur d applications SafeDesk.
Ecoute sur 127.0.0.1:3010, expose UNIQUEMENT via nginx (meme auth que le bureau).
  GET /apps          -> liste des tuiles disponibles
  GET /run?app=<id>  -> lance l application (LISTE BLANCHE, jamais d exec arbitraire)
Personnalisation par deploiement : /config/.config/safedesk/apps.json (fusionne).
"""
import json
import os
import subprocess
import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer

DEFAULTS = {
    "internet": {"label": "Internet", "icon": "\U0001F310", "cmd": ["wrapped-google-chrome"]},
    "fichiers": {"label": "Mes fichiers", "icon": "\U0001F4C1", "cmd": ["dolphin"]},
    "mails": {"label": "Mes mails", "icon": "\u2709\uFE0F",
              "cmd": ["wrapped-google-chrome", "https://mail.google.com"]},
}
CFG = "/config/.config/safedesk/apps.json"


def apps():
    merged = dict(DEFAULTS)
    try:
        with open(CFG, encoding="utf-8") as f:
            merged.update(json.load(f))
    except Exception:
        pass
    return merged


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(url.query)
        if url.path == "/apps":
            self._json(200, {k: {"label": v["label"], "icon": v.get("icon", "")}
                             for k, v in apps().items()})
            return
        if url.path == "/run":
            app_id = (query.get("app") or [""])[0]
            app = apps().get(app_id)
            if not app or not isinstance(app.get("cmd"), list):
                self._json(404, {"error": "application inconnue"})
                return
            env = dict(os.environ, DISPLAY=":1", HOME="/config")
            try:
                subprocess.Popen(app["cmd"], env=env, start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self._json(200, {"ok": True, "app": app_id})
            except Exception as exc:
                self._json(500, {"error": str(exc)})
            return
        self._json(404, {"error": "inconnu"})


if __name__ == "__main__":
    HTTPServer(("127.0.0.1", 3010), Handler).serve_forever()