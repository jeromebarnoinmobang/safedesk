#!/usr/bin/env python3
"""Lanceur d applications SafeDesk (tuiles de l accueil telephone).
127.0.0.1:3010, expose via nginx /safedesk/ (meme auth que le bureau).
  GET /apps          -> tuiles
  GET /run?app=<id>  -> lance (LISTE BLANCHE) puis maximise la fenetre
Personnalisation : /config/.config/safedesk/apps.json (fusionne aux defauts).
"""
import json
import os
import subprocess
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer

DEFAULTS = {
    "internet": {"label": "Internet", "icon": "\U0001F310", "cmd": ["wrapped-google-chrome", "--app=https://duckduckgo.com"]},
    "fichiers": {"label": "Mes fichiers", "icon": "\U0001F4C1", "cmd": ["dolphin"]},
    "mails": {"label": "Mes mails", "icon": "\u2709\uFE0F",
              "cmd": ["wrapped-google-chrome", "--app=https://mail.google.com"]},
}
CFG = "/config/.config/safedesk/apps.json"
ENV = dict(os.environ, DISPLAY=":1", HOME="/config")


def _which(prog):
    for p in os.environ.get("PATH", "/usr/bin:/bin").split(":"):
        f = os.path.join(p, prog)
        if os.path.exists(f) and os.access(f, os.X_OK):
            return f
    return None


def apps():
    merged = dict(DEFAULTS)
    try:
        with open(CFG, encoding="utf-8") as f:
            merged.update(json.load(f))
    except Exception:
        pass
    return merged


def _name(win):
    try:
        r = subprocess.run(["xdotool", "getwindowname", win],
                           env=ENV, capture_output=True, text=True, timeout=4)
        return r.stdout.strip()
    except Exception:
        return ""


def maximize_after(pid):
    """Maximise la fenetre nouvellement mise au premier plan (best-effort).
    Robuste pour Chrome --app (fenetre dediee qui prend le focus)."""
    for _ in range(25):
        time.sleep(0.4)
        try:
            r = subprocess.run(["xdotool", "getactivewindow"],
                               env=ENV, capture_output=True, text=True, timeout=4)
            w = r.stdout.strip()
            if not w:
                continue
            nm = _name(w)
            if not nm or nm.startswith("Desktop"):
                continue
            subprocess.run(["xdotool", "windowsize", w, "100%", "100%",
                            "windowmove", w, "0", "0"], env=ENV, timeout=4)
            subprocess.run(["xdotool", "key", "--window", w, "super+Page_Up"],
                           env=ENV, timeout=4)
            return
        except Exception:
            pass


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        if u.path == "/tts":
            text = (q.get("text") or [""])[0][:600].strip()
            if not text:
                self.send_response(400); self.end_headers(); return
            wav = "/tmp/sd-tts-%d.wav" % (abs(hash(text)) % 100000)
            ok = False
            if _which("pico2wave"):
                ok = subprocess.run(["pico2wave", "-l", "fr-FR", "-w", wav, text],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if not ok and _which("espeak-ng"):
                ok = subprocess.run(["espeak-ng", "-v", "fr", "-s", "150", "-w", wav, text],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if not ok or not os.path.exists(wav):
                self.send_response(500); self.end_headers(); return
            data = open(wav, "rb").read()
            try: os.remove(wav)
            except OSError: pass
            self.send_response(200)
            self.send_header("Content-Type", "audio/wav")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)
            return
        if u.path == "/apps":
            self._json(200, {k: {"label": v["label"], "icon": v.get("icon", "")}
                             for k, v in apps().items()})
            return
        if u.path == "/run":
            app = apps().get((q.get("app") or [""])[0])
            if not app or not isinstance(app.get("cmd"), list):
                self._json(404, {"error": "application inconnue"})
                return
            try:
                p = subprocess.Popen(app["cmd"], env=ENV, start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                threading.Thread(target=maximize_after, args=(p.pid,), daemon=True).start()
                self._json(200, {"ok": True})
            except Exception as exc:
                self._json(500, {"error": str(exc)})
            return
        self._json(404, {"error": "inconnu"})


if __name__ == "__main__":
    HTTPServer(("127.0.0.1", 3010), Handler).serve_forever()