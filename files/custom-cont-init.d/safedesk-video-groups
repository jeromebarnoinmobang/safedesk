#!/usr/bin/with-contenv bash
# SafeDesk AV : donne a abc l acces aux /dev/video* passes par docker-compose.av.yml.
# Le gid des nodes vient de l HOTE ; on cree/rejoint le groupe correspondant.
# (l init-video de l image linuxserver ne scanne que /dev/dri et /dev/dvb, pas /dev/video*)
for dev in /dev/video*; do
  [ -c "$dev" ] || continue
  gid=$(stat -c %g "$dev")
  getent group "$gid" >/dev/null || groupadd -g "$gid" "hostvideo$gid"
  gname=$(getent group "$gid" | cut -d: -f1)
  usermod -a -G "$gname" abc 2>/dev/null || true
done
