#!/usr/bin/with-contenv bash
# SafeDesk — la chaîne OpenWork, montée au démarrage et GARDÉE.
#
# POURQUOI UN SERVICE ET PAS UNE ICÔNE (26/08/2026)
#
# Tant que la chaîne était démarrée par l'icône du bureau, elle ne repartait pas
# au redémarrage du conteneur : l'état du poste dépendait d'un clic. Et quand un
# maillon mourait, rien ne le relevait — le 25-26/08, une panne a duré plus de
# 24 h derrière un front qui répondait 200 en pointant sur une API en 502.
#
# Ici, s6 supervise. Toutes les 30 s, `openwork-chaine assurer` CONSTATE chaque
# maillon et ne répare que ce qui manque. Le contrôle ne se contente pas d'un 200
# sur le front : il lit, dans /proc du processus vite vivant, l'API que le front
# appelle réellement, et vérifie que cette API répond.
#
# ACTIVATION : les deux fichiers d'identifiants doivent exister dans /config
# (qui persiste, donc une recréation du conteneur ne les perd pas) :
#   /config/.config/safedesk/opencode-vps.env   OPENCODE_SERVER_USERNAME/PASSWORD
#   /config/.config/safedesk/openwork.env       OPENWORK_TOKEN
# Sans eux, le service attend sagement plutôt que de boucler sur une erreur.
#
# DÉSACTIVATION : poser /config/.config/safedesk/openwork.off

INTERVALLE=${OPENWORK_ASSURER_INTERVAL:-30}
CHAINE=/usr/local/bin/openwork-chaine
[ -x "$CHAINE" ] || CHAINE=/config/.local/bin/openwork-chaine

ENV_OC=/config/.config/safedesk/opencode-vps.env
ENV_OW=/config/.config/safedesk/openwork.env
HORS=/config/.config/safedesk/openwork.off

ETAT=/config/.local/state/safedesk
mkdir -p "$ETAT"
chown -R abc:abc "$ETAT" 2>/dev/null

if [ ! -x "$CHAINE" ]; then
  echo "[openwork] openwork-chaine introuvable — service inactif"
  sleep infinity
fi

# Laisser le réseau, le DNS et l'agent ssh se poser. Sans cette attente, le premier
# essai échoue toujours et remplit le journal d'un faux incident à chaque boot.
sleep 20

while true; do
  if [ -f "$HORS" ]; then
    sleep "$INTERVALLE"; continue
  fi
  if [ -r "$ENV_OC" ] && [ -r "$ENV_OW" ]; then
    s6-setuidgid abc env HOME=/config PATH="/config/.local/bin:/usr/local/bin:/usr/bin:/bin" \
      "$CHAINE" assurer >/dev/null 2>&1
  fi
  sleep "$INTERVALLE"
done
