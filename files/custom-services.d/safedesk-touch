#!/usr/bin/with-contenv bash
# SafeDesk TACTILE : Plasma Wayland directement sur l'ecran de la machine.
# Actif seulement si SAFEDESK_TOUCH=1 (pose par docker-compose.touch.yml).
[ "${SAFEDESK_TOUCH:-}" = "1" ] || exec sleep infinity

LOG=/tmp/safedesk-touch.log
exec >>"$LOG" 2>&1
echo "== $(date -Is) safedesk-touch : demarrage"

# ── LE SIEGE : la session logind de l'HOTE (mesure le 14/09/2026) ──────────
# KWin 6.3 ne parle pas libseat et n'ouvre pas les peripheriques lui-meme sur
# le DRM : il demande a logind (TakeControl, puis TakeDevice pour chaque carte
# et chaque entree). Il cherche SA session par XDG_SESSION_ID, ou « auto » —
# et « auto » echoue depuis un conteneur (le processus n'appartient a aucune
# session). Mais l'hote, lui, a une session pour l'utilisateur 1000 : celle de
# l'autologin sur tty1 (seat0, active). On la designe explicitement, via le bus
# systeme de l'hote (/run/dbus/system_bus_socket, monte par le compose).
# Consequence heureuse : aucun droit sur /dev n'est necessaire, logind passe
# les descripteurs ouverts. Verifie : TakeControl accepte depuis le conteneur.
USER_PATH=$(dbus-send --system --print-reply --dest=org.freedesktop.login1 \
  /org/freedesktop/login1 org.freedesktop.login1.Manager.GetUser uint32:1000 2>/dev/null \
  | awk '/object path/ {gsub(/"/,"",$3); print $3}')
SESSION_ID=$(dbus-send --system --print-reply --dest=org.freedesktop.login1 \
  "$USER_PATH" org.freedesktop.DBus.Properties.Get \
  string:org.freedesktop.login1.User string:Display 2>/dev/null \
  | awk '/string/ {gsub(/"/,"",$2); print $2}')
if [ -z "$SESSION_ID" ]; then
  echo "ECHEC : pas de session logind pour l'utilisateur 1000 sur l'hote (autologin tty1 ?)."
  echo "        USER_PATH=$USER_PATH — verifier /run/dbus/system_bus_socket et loginctl."
  sleep 20; exit 1
fi
echo "session logind de l'hote : $SESSION_ID ($USER_PATH)"

# Xwayland (applications X11 dans la session Wayland) exige ce dossier.
install -d -m 1777 /tmp/.X11-unix

# Un runtime dir LOCAL a la machine (pas le home synchronise) pour les sockets.
RUNTIME=/tmp/runtime-abc
install -d -m 0700 -o abc -g abc "$RUNTIME"

# LA PREUVE avant de lancer : l'ecran et la dalle sont bien la.
for c in /sys/class/drm/card*-*; do
  [ "$(cat "$c/status" 2>/dev/null)" = "connected" ] && echo "ecran : $(basename "$c") $(head -1 "$c/modes" 2>/dev/null)"
done
grep -l 'ID_INPUT_TOUCHSCREEN=1' /run/udev/data/+input:input* 2>/dev/null | head -1 | xargs -r -I{} echo "dalle tactile : {}"

# Le clavier a l'ecran : kwin ne lance Maliit que si kwinrc le designe, et il ne
# relit ce reglage QU'AU DEMARRAGE (mesure le 14/09 : un reconfigure ne suffit
# pas, available restait false). On le pose avant de lancer la session, une fois.
KWINRC=/config/.config/kwinrc
if [ -x /usr/bin/maliit-keyboard ] && ! grep -q '^InputMethod=' "$KWINRC" 2>/dev/null; then
  s6-setuidgid abc env HOME=/config kwriteconfig6 --file "$KWINRC" --group Wayland     --key InputMethod /usr/share/applications/com.github.maliit.keyboard.desktop
  s6-setuidgid abc env HOME=/config kwriteconfig6 --file "$KWINRC" --group Wayland     --key VirtualKeyboardEnabled true
  echo "clavier a l'ecran : Maliit declare dans kwinrc"
fi

# KWIN_IM_SHOW_ALWAYS : sans lui, kwin n'ouvre le clavier a l'ecran que si la
# DERNIERE entree etait tactile (inputmethod.cpp, shouldShowOnActive). Un champ
# qui recoit le focus autrement (lancement d'une fenetre, raccourci) reste muet,
# et un tap ulterieur dans ce meme champ ne re-declenche rien. Sur un poste sans
# clavier physique, on veut le clavier a CHAQUE champ actif — mesure le 14/09.
# Plasma Wayland sur le DRM : ni DISPLAY ni WAYLAND_DISPLAY, sinon kwin se croit
# imbrique dans un autre serveur graphique et n'ouvre jamais l'ecran.
cd /config
exec s6-setuidgid abc env -u DISPLAY -u WAYLAND_DISPLAY -u LD_PRELOAD \
  HOME=/config \
  XDG_RUNTIME_DIR="$RUNTIME" \
  XDG_SESSION_TYPE=wayland \
  XDG_SESSION_ID="$SESSION_ID" \
  XDG_CURRENT_DESKTOP=KDE \
  KWIN_DRM_DEVICES="${KWIN_DRM_DEVICES:-/dev/dri/card1}" \
  QT_QPA_PLATFORM=wayland \
  KWIN_IM_SHOW_ALWAYS=1 \
  dbus-run-session -- /usr/bin/startplasma-wayland
