#!/usr/bin/with-contenv bash
# Pose les icones SafeDesk sur le bureau de l utilisateur (une fois, idempotent).
#
# L icone SafeWork n est plus posee ici depuis le 29/08/2026 : elle est partie avec
# la chaine dans le depot PRIVE `safework` (dossier poste/), parce que ce depot-ci
# est public. Elle est posee par `poste/installer.sh`.
#
# La lecon de 26/08 reste : une icone ecrite a la main dans /config/Desktop survit a
# un redemarrage mais pas a une reinstallation, et deux copies hors depot d une meme
# chose sont la definition meme de la derive. C est pour ca qu elle est versionnee —
# simplement dans l autre depot.
mkdir -p /config/Desktop
for name in safedesk-qr; do
  src="/usr/share/applications/$name.desktop"
  dst="/config/Desktop/$name.desktop"
  if [ -f "$src" ] && [ ! -f "$dst" ]; then
    cp "$src" "$dst"
    chmod +x "$dst"
    chown abc:abc "$dst"
  fi
done
sleep infinity
