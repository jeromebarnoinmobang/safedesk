#!/usr/bin/with-contenv bash
# webtop REGENERE sa conf nginx au demarrage : on injecte nos locations apres coup.
# - /safedesk/ -> launcher local (tuiles accueil telephone)
# - /voice/    -> sidecar assistant vocal (compose overlay docker-compose.voice.yml)
#   Resolution DNS DIFFEREE (resolver Docker + variable) : nginx demarre et se
#   recharge meme si le sidecar voice n'est pas deploye (seul /voice/ fait 502).
CONF=/etc/nginx/sites-available/default
# The VPS router adds X-SafeDesk-VPC only after it has established that the
# request comes from the private VPN path.  Keep the public endpoint protected
# by the regular Webtop Basic Auth prompt; the Pi must never store that secret.
cat > /etc/nginx/conf.d/safedesk-vpc-auth.conf <<'EOF'
map $http_x_safedesk_vpc $safedesk_auth_realm {
  default "Login";
  "true"   off;
}
EOF
for i in $(seq 1 60); do
  [ -f "$CONF" ] && grep -q "auth_basic_user_file" "$CONF" && break
  sleep 1
done
if grep -q 'auth_basic               "Login";' "$CONF" 2>/dev/null; then
  sed -i 's/auth_basic               "Login";/auth_basic               $safedesk_auth_realm;/' "$CONF"
fi
if ! grep -q "location /safedesk/" "$CONF" 2>/dev/null; then
  # inserer le bloc apres CHAQUE ligne auth_basic_user_file (les 2 vhosts)
  awk '
    { print }
    /auth_basic_user_file/ {
      print "  location /safedesk/ {"
      print "    proxy_pass http://127.0.0.1:3010/;"
      print "    proxy_read_timeout 30s;"
      print "  }"
    }
  ' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
fi
if ! grep -q "location /voice/" "$CONF" 2>/dev/null; then
  # -> service s6 safedesk-voice (shim in-container sur 8088)
  awk '
    { print }
    /auth_basic_user_file/ {
      print "  location = /voice { return 302 /voice/; }"
      print "  location /voice/ {"
      print "    proxy_pass http://127.0.0.1:8088;"
      print "    proxy_http_version 1.1;"
      print "    proxy_buffering off;"          # SSE : les deltas partent au fil de l eau
      print "    proxy_request_buffering off;"
      print "    proxy_read_timeout 300s;"      # tours longs (cerveau agit / cold start GPU)
      print "    client_max_body_size 20m;"     # upload blob micro (webm/mp4)
      print "  }"
    }
  ' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
fi
# recharger si nginx tourne (sinon il demarrera avec la bonne conf)
for i in $(seq 1 30); do
  if pgrep -x nginx >/dev/null; then
    nginx -t >/dev/null 2>&1 && nginx -s reload 2>/dev/null && break
  fi
  sleep 2
done
sleep infinity
