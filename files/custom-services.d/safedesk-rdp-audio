#!/usr/bin/with-contenv bash
# SafeDesk : audio RDP BIDIRECTIONNEL, 100% automatique, pour TOUTES les apps.
#   OUTPUT (orchestrateur -> toi) : module-xrdp-sink   sur xrdp_chansrv_audio_out_socket_*
#   INPUT  (toi -> orchestrateur) : module-xrdp-source sur xrdp_chansrv_audio_in_socket_*
# Bascule les peripheriques par defaut + rapatrie les flux a chaque (de)connexion RDP.
UIDN=$(id -u abc 2>/dev/null || echo 1000)
SOCKDIR="/run/xrdp/sockdir/${UIDN}"
pa() { s6-setuidgid abc env HOME=/config pactl "$@"; }
for i in $(seq 1 90); do pa info >/dev/null 2>&1 && break; sleep 1; done
prev_out=""; prev_in=""
while true; do
  OUT=$(ls -t "${SOCKDIR}"/xrdp_chansrv_audio_out_socket_* 2>/dev/null | head -1)
  IN=$(ls -t "${SOCKDIR}"/xrdp_chansrv_audio_in_socket_* 2>/dev/null | head -1)

  # ---- OUTPUT : l'orchestrateur te parle ----
  if [ -n "$OUT" ]; then
    if [ "$OUT" != "$prev_out" ]; then
      for m in $(pa list modules short 2>/dev/null | grep -i "module-xrdp-sink" | cut -f1); do pa unload-module "$m" 2>/dev/null; done
      pa load-module module-xrdp-sink xrdp_socket_path="${SOCKDIR}" xrdp_pulse_sink_socket="$(basename "$OUT")" >/dev/null 2>&1
      pa set-default-sink xrdp-sink 2>/dev/null
      for si in $(pa list sink-inputs short 2>/dev/null | cut -f1); do pa move-sink-input "$si" xrdp-sink 2>/dev/null; done
      prev_out="$OUT"
    fi
  else
    if [ -n "$prev_out" ]; then
      pa set-default-sink output 2>/dev/null
      for si in $(pa list sink-inputs short 2>/dev/null | cut -f1); do pa move-sink-input "$si" output 2>/dev/null; done
      prev_out=""
    fi
  fi

  # ---- INPUT : tu parles a l'orchestrateur (ton micro) ----
  if [ -n "$IN" ]; then
    if [ "$IN" != "$prev_in" ]; then
      for m in $(pa list modules short 2>/dev/null | grep -i "module-xrdp-source" | cut -f1); do pa unload-module "$m" 2>/dev/null; done
      pa load-module module-xrdp-source xrdp_socket_path="${SOCKDIR}" xrdp_pulse_source_socket="$(basename "$IN")" >/dev/null 2>&1
      pa set-default-source xrdp-source 2>/dev/null
      for so in $(pa list source-outputs short 2>/dev/null | cut -f1); do pa move-source-output "$so" xrdp-source 2>/dev/null; done
      prev_in="$IN"
    fi
  else
    if [ -n "$prev_in" ]; then
      pa set-default-source output.monitor 2>/dev/null
      prev_in=""
    fi
  fi

  sleep 2
done