#!/usr/bin/with-contenv bash
# SafeDesk : audio RDP 100% automatique, pour TOUTES les apps.
# - session RDP connectee -> module-xrdp-sink sur SA socket + xrdp-sink par defaut
#   + rapatriement des flux en cours -> le son de n'importe quelle app sort chez toi.
# - plus de RDP -> retour sur 'output' (navigateur/Selkies).
# Aucune intervention, jamais.
UIDN=$(id -u abc 2>/dev/null || echo 1000)
SOCKDIR="/run/xrdp/sockdir/${UIDN}"
pa() { s6-setuidgid abc env HOME=/config pactl "$@"; }
for i in $(seq 1 90); do pa info >/dev/null 2>&1 && break; sleep 1; done
prev=""
while true; do
  SOCK=$(ls -t "${SOCKDIR}"/xrdp_chansrv_audio_out_socket_* 2>/dev/null | head -1)
  if [ -n "$SOCK" ]; then
    if [ "$SOCK" != "$prev" ]; then
      NAME=$(basename "$SOCK")
      for m in $(pa list modules short 2>/dev/null | grep -iE "module-xrdp-(sink|source)" | cut -f1); do pa unload-module "$m" 2>/dev/null; done
      pa load-module module-xrdp-sink xrdp_socket_path="${SOCKDIR}" xrdp_pulse_sink_socket="$NAME" >/dev/null 2>&1
      pa set-default-sink xrdp-sink 2>/dev/null
      for si in $(pa list sink-inputs short 2>/dev/null | cut -f1); do pa move-sink-input "$si" xrdp-sink 2>/dev/null; done
      prev="$SOCK"
    fi
  else
    if [ -n "$prev" ]; then
      pa set-default-sink output 2>/dev/null
      for si in $(pa list sink-inputs short 2>/dev/null | cut -f1); do pa move-sink-input "$si" output 2>/dev/null; done
      prev=""
    fi
  fi
  sleep 2
done