#!/usr/bin/with-contenv bash
# SafeDesk : audio RDP. Une boucle qui re-forcait le defaut en permanence RETOMBAIT sur
# output -> supprimee. Ici on pose xrdp-sink UNE fois, apres que la session + KDE se
# soient stabilises, puis on dort. default.pa le pose deja au boot ; ceci est le filet.
SD=/run/xrdp/sockdir/1000
pa(){ s6-setuidgid abc env HOME=/config pactl "$@"; }
for i in $(seq 1 120); do pa info >/dev/null 2>&1 && break; sleep 1; done
for m in module-stream-restore module-device-restore module-default-device-restore module-switch-on-port-available; do pa unload-module $m 2>/dev/null; done
for i in $(seq 1 300); do ls $SD/xrdp_display_* >/dev/null 2>&1 && break; sleep 1; done
sleep 15
XS=$(pa list sinks short 2>/dev/null | grep -P "\txrdp-sink\t" | cut -f1)
pa set-default-sink xrdp-sink 2>/dev/null
for si in $(pa list sink-inputs short 2>/dev/null | cut -f1); do pa move-sink-input "$si" "$XS" 2>/dev/null; done
exec sleep infinity