// SafeDesk — regles d'exclusion Syncthing du home /config
//
// POURQUOI : un profil d'application EN COURS D'EXECUTION (bases LevelDB/SQLite,
// verrous, caches) ne peut pas etre replique entre deux machines qui tournent en
// meme temps. Le resultat observe le 17/08/2026 : 235 fichiers .sync-conflict-*
// dont 99 dans le profil Claude Desktop, et le login qui saute.
//
// Ce qui reste synchronise : les documents, les projets, les configurations
// (dont claude_desktop_config.json = les serveurs MCP). Ce qui ne l'est plus :
// les sessions, les cookies, les trousseaux et les caches — ils sont LOCAUX a la
// machine par nature. Consequence assumee : un login par machine.

// --- conflits deja crees : ne plus jamais les propager ---
(?d)**/*.sync-conflict-*

// --- trousseau : la cle qui dechiffre les cookies est propre a la machine ---
/.local/share/kwalletd

// --- Claude Desktop : etat d'execution (le reste du dossier suit) ---
/.config/Claude/Singleton*
/.config/Claude/Cookies*
/.config/Claude/Local State
/.config/Claude/Local Storage
/.config/Claude/Session Storage
/.config/Claude/IndexedDB
/.config/Claude/Service Worker
/.config/Claude/Partitions
/.config/Claude/Cache
/.config/Claude/Code Cache
/.config/Claude/GPUCache
/.config/Claude/DawnGraphiteCache
/.config/Claude/DawnWebGPUCache
/.config/Claude/blob_storage
/.config/Claude/Crashpad
/.config/Claude/logs
/.config/Claude/sentry
/.config/Claude/Network Persistent State
/.config/Claude/DIPS*
/.config/Claude/InterestGroups*
/.config/Claude/fcache
/.config/Claude/.safedesk-display

// --- Google Chrome : meme raison (90 conflits au 17/08) ---
/.config/google-chrome/Singleton*
/.config/google-chrome/*/Cookies*
/.config/google-chrome/Local State
/.config/google-chrome/*/Local Storage
/.config/google-chrome/*/Session Storage
/.config/google-chrome/*/IndexedDB
/.config/google-chrome/*/Service Worker
/.config/google-chrome/*/Cache
/.config/google-chrome/*/Code Cache
/.config/google-chrome/*/GPUCache
/.config/google-chrome/*/Sessions
/.config/google-chrome/ShaderCache
/.config/google-chrome/GrShaderCache
/.config/google-chrome/GraphiteDawnCache
/.config/google-chrome/Crashpad


// --- Thorium (ARM64 : le Chrome des Raspberry Pi) : meme raison que ci-dessus ---
//
// Thorium est un Chromium : il a exactement les memes fichiers d'etat, et ils
// posent exactement le meme probleme. Le profil ne vit PAS dans
// .config/google-chrome — un profil ecrit par Chrome 151 est refuse net par un
// Chromium 138 (« profil cree par une version plus recente »). Les deux
// navigateurs cohabitent donc dans deux dossiers distincts, et chacun garde sa
// session.
/.config/thorium/Singleton*
/.config/thorium/*/Cookies*
/.config/thorium/Local State
/.config/thorium/*/Local Storage
/.config/thorium/*/Session Storage
/.config/thorium/*/IndexedDB
/.config/thorium/*/Service Worker
/.config/thorium/*/Cache
/.config/thorium/*/Code Cache
/.config/thorium/*/GPUCache
/.config/thorium/*/Sessions
/.config/thorium/ShaderCache
/.config/thorium/GrShaderCache
/.config/thorium/GraphiteDawnCache
/.config/thorium/Crashpad

// --- caches de gestionnaires de paquets : reconstructibles, jamais a repliquer ---
//
// Mesure le 28/08/2026 sur le poste, en branchant le Raspberry Pi a la flotte :
//   .bun/install/cache   2,8 Go   137 653 fichiers
//   .npm/_cacache        988 Mo     3 101 fichiers
//   .local/share/pnpm/store 659 Mo  47 919 fichiers
// Soit ~4,4 Go et ~188 000 fichiers — plus d'entrees a elles seules que tout le
// reste du home reuni. Syncthing indexe, hache et surveille chacune, sur CHAQUE
// machine. Le Pi rampait a 40 Kio/s en traitant cet index, sans avoir encore
// transfere le moindre octet utile.
//
// Rien de tout cela n'a de valeur : ce sont des archives telechargeables que npm,
// bun et pnpm reconstruisent seuls a la premiere commande. C'est la meme raison
// qui excluait deja /.cache — elle vaut pour ceux-la aussi, ils avaient simplement
// ete oublies.
/.npm/_cacache
/.npm/_npx
/.bun/install/cache
/.local/share/pnpm/store
/.cargo/registry

// --- divers etats de session de bureau ---
/.XDG/KSMserver*
/.cache
