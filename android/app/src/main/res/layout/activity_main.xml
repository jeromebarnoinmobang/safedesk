<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="32dp" android:background="#0F1115">

    <ImageView
        android:layout_width="96dp" android:layout_height="96dp"
        android:src="@drawable/ic_launcher" android:contentDescription="@string/app_name"/>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/welcome_title"
        android:textColor="#E8ECF3" android:textSize="26sp" android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/welcome_sub"
        android:textColor="#8B94A7" android:textSize="15sp" android:gravity="center"/>

    <Button
        android:id="@+id/btn_scan"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="40dp" android:text="@string/btn_scan"
        android:textSize="17sp" android:textColor="#0F1115"
        android:backgroundTint="#2DD4BF"/>
</LinearLayout>