# voice/.env.example — copier en voice/.env (gitignored) et remplir.
# L'assistant vocal SafeDesk = sidecar "voice" (cf. docker-compose.voice.yml à
# la racine). Page servie sur https://<ton-bureau>/voice/ (auth du bureau).

# ============================ LE CERVEAU =====================================
# claude (défaut) : CLI claude sur abonnement Max — agentique (vrais outils),
#                   AUCUNE clé API, zéro facturation token.
# openai          : n'importe quel endpoint OpenAI-compatible — cas nominal =
#                   LLM serverless RunPod (vLLM), scale-to-zero. Conversation
#                   pure (pas d'outils), historique glissant géré par le shim.
# relay           : cerveau EXTERNE. Avec VOICE_RELAY_URL → hub vocal du
#                   second-brain (un agent MCP répond via voice_wait /
#                   voice_answer, de n'importe quelle session) ; sans URL →
#                   fichiers locaux consommés par mcp-voice.mjs.
VOICE_BRAIN=claude

# ---- cerveau "relay" distant (hub vocal second-brain) -----------------------
#VOICE_RELAY_URL=            # ex. https://second-brain.mobang.fr
#VOICE_RELAY_TOKEN=          # = VOICE_RELAY_TOKEN du serveur second-brain.
                             # ⚠️ à protéger comme un secret fort : il permet de
                             # parler À l'agent au nom du micro. openssl rand -hex 32
#VOICE_DESK_NAME=            # nom de CE bureau vu par l'agent (défaut: hostname)
                             # ⚠️ garder BRAIN_TIMEOUT_MS < TTL des tours côté
                             # hub (5 min) — sinon un tour peut expirer en cours

# ---- cerveau "claude" -------------------------------------------------------
# Token généré par `claude setup-token` sur ta machine (valable 1 an, Max).
CLAUDE_CODE_OAUTH_TOKEN=
VOICE_MODEL=opus            # alias CLI : opus | sonnet | haiku
VOICE_EFFORT=medium         # low|medium|high|xhigh|max — medium = fluide en vocal

# ---- cerveau "openai" (LLM RunPod serverless ou autre) ----------------------
# RunPod vLLM : renseigne juste l'ID d'endpoint, l'URL /openai/v1 est déduite
# (auth = RUNPOD_API_KEY ci-dessous). Autre fournisseur : BRAIN_OPENAI_BASE_URL
# + BRAIN_OPENAI_API_KEY explicites.
RUNPOD_LLM_ENDPOINT_ID=
#BRAIN_OPENAI_BASE_URL=      # ex. https://api.runpod.ai/v2/<id>/openai/v1
#BRAIN_OPENAI_API_KEY=       # défaut = RUNPOD_API_KEY
BRAIN_OPENAI_MODEL=          # nom du modèle servi par le worker (obligatoire)
#BRAIN_OPENAI_MAX_TOKENS=700 # réponses vocales = courtes
#VOICE_HISTORY_TURNS=8       # tours de contexte renvoyés au LLM stateless
#BRAIN_TIMEOUT_MS=120000     # monter (ex. 240000) si cold start vLLM lent

# ---- réglages communs -------------------------------------------------------
BRAIN_SHIM_PORT=8088
# La page /voice/ est déjà derrière l'auth Basic du bureau SafeDesk → token
# optionnel ici. OBLIGATOIRE si tu exposes le shim directement (vhost public) :
# openssl rand -hex 32 — la page l'envoie en X-Voice-Token (/voice#t=<token>).
BRAIN_SHIM_TOKEN=
# Persona : gardien vocal SafeDesk par défaut. VOICE_USER_NAME personnalise
# ("Tu parles avec <nom>") ; SHIM_SYSTEM_PROMPT remplace tout le prompt.
VOICE_USER_NAME=
#SHIM_SYSTEM_PROMPT=

# ---- mémoire/outils second-brain (cerveau claude uniquement, optionnel) -----
SECOND_BRAIN_MCP_URL=
SECOND_BRAIN_MCP_TOKEN=
VOICE_PLANE_PROJECT=

# ---- Audio serverless RunPod (STT faster-whisper + TTS Kyutai 1.6B GPU) -----
# Endpoints scale-to-zero (flashboot, idleTimeout 120 s) — gratuit au repos,
# quelques centimes par conversation.
RUNPOD_API_KEY=
RUNPOD_STT_ENDPOINT_ID=     # image officielle runpod/ai-api-faster-whisper
RUNPOD_TTS_ENDPOINT_ID=     # worker Kyutai TTS 1.6B (kyutai/tts-1.6b-en_fr)
VOICE_STT_MODEL=turbo       # large-v3-turbo — multilingue, rapide, précis en FR
VOICE_STT_LANGUAGE=fr
#VOICE_STT_PROMPT=          # biais de vocabulaire (tes noms propres)
RUNPOD_TTS_VOICE=unmute-prod-website/developpeuse-3.wav  # voix FR (kyutai/tts-voices)
#STT_TIMEOUT_MS=90000
#TTS_TIMEOUT_MS=90000

# ---- Fallback voix LOCALE (pocket-tts CPU, profil compose tts-fallback) -----
# Utilisé seulement si l'appel RunPod TTS échoue. "off" pour désactiver.
VOICE_TTS_URL=http://voice-tts:8000
VOICE_TTS_VOICE=estelle
#HUGGING_FACE_HUB_TOKEN=    # requis par le modèle gated kyutai/pocket-tts
